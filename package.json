{
  "name": "ekklesia-soft-ui",
  "version": "1.0.0",
  "description": "EkklesiaSoft - Multi-tenant SaaS Application",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:ci": "jest --runInBand --reporters=default --reporters=jest-junit",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e:rbac": "playwright test e2e/tenant-rbac.spec.ts",
    "e2e:cross-tenant": "playwright test e2e/cross-tenant-isolation.spec.ts",
    "e2e:sacraments": "playwright test e2e/sacraments",
    "e2e:church-profile-leadership": "playwright test e2e/church-profile/church-profile.spec.ts -g leadership",
    "e2e:church-profile": "playwright test e2e/church-profile/church-profile.spec.ts"
  },
  "private": true,
  "overrides": {
    "glob": "^11.0.0",
    "rimraf": "^6.0.0"
  },
  "dependencies": {
    "@angular/animations": "21.2.13",
    "@angular/common": "21.2.13",
    "@angular/compiler": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/forms": "21.2.13",
    "@angular/platform-browser": "21.2.13",
    "@angular/platform-browser-dynamic": "21.2.13",
    "@angular/router": "21.2.13",
    "@ng-select/ng-select": "21.8.2",
    "@ngrx/effects": "21.1.0",
    "@ngrx/store": "21.1.0",
    "@ngrx/store-devtools": "21.1.0",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-link": "3.29.2",
    "@tiptap/extension-placeholder": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "chart.js": "4.5.1",
    "chartjs-chart-sankey": "0.15.0",
    "libphonenumber-js": "1.12.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.13",
    "@angular/cli": "21.2.13",
    "@angular/compiler-cli": "21.2.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "16.1.5",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2"
  }
}
